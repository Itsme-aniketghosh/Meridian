====================================================================================================
[step 2/10]  4. Airflow DAGs (and 9. Flow optimisation)
====================================================================================================

$ python -c "from dags.pipeline_spec import DAGS; print(DAGS)"

  DAG meridian_update  (11 tasks; task <- the tasks it waits for)
    anything_new  <- (start)                         [gate: exit 0 = go on, 99 = stop]
    collect       <- anything_new                 writes run
    history       <- collect                      writes git_commit, commit_file, ticket, ticket_event, ticket
    scan          <- collect                      writes candidate, parse_failure, module_import, deprecation
    resolve       <- scan                         writes resolution, call_edge
    owners        <- history                      writes person, person_alias, team_map, file_owner
    join          <- history, resolve, owners     writes call_site, ticket_map, coverage
    graph         <- join                         writes blocked_by, blast_radius, chain
    validate      <- graph                        
    report        <- validate                     
    publish       <- report                       

  DAG meridian_rebuild  (14 tasks; task <- the tasks it waits for)
    fresh         <- (start)                      
    collect       <- fresh                        writes run
    history       <- collect                      writes git_commit, commit_file, ticket, ticket_event, ticket
    scan          <- collect                      writes candidate, parse_failure, module_import, deprecation
    resolve       <- scan                         writes resolution, call_edge
    owners        <- history                      writes person, person_alias, team_map, file_owner
    join          <- history, resolve, owners     writes call_site, ticket_map, coverage
    graph         <- join                         writes blocked_by, blast_radius, chain
    validate      <- graph                        
    bias          <- validate                     
    gx            <- validate                     
    report        <- validate                     
    compare       <- report                          [gate: exit 3 = go on, 0 = stop]
    publish       <- compare                      

WHAT YOU JUST SAW: both Airflow DAGs as data (dags/meridian_dag.py builds them from this file;
  tests/test_dag.py checks it). history and scan->resolve both wait only on collect, so they run
  side by side: that parallel split is the flow optimisation (rubric 9; ~1,130 s in sequence -> ~700
  s, README 'Pipeline flow').

