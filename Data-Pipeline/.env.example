# Copy to .env (git ignores it) and fill in. Only what docker compose and the secrets need lives here: every other
# setting is in settings.toml.

# Airflow. AIRFLOW_UID: on Linux your `id -u`, so files written into the repo are yours
AIRFLOW_UID=50000
# the web UI: http://localhost:8080. Its login also drives the dashboard's Update graph button (settings.toml [dags.update])
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
# AIRFLOW_IMAGE=apache/airflow:2.10.5-python3.11

# Alert secrets. The names are the ones settings.toml [alerts] names; leave one empty to skip that channel
MERIDIAN_SLACK_WEBHOOK=
MERIDIAN_SMTP_USER=
MERIDIAN_SMTP_PASSWORD=
