# Copy to terraform.tfvars (git ignores it): the billing account id and the emails stay out of git.
# Both are required, so an apply without this file stops instead of removing the budget.

# The budget (C7). Find it with: gcloud billing projects describe <project-id>
billing_account = "000000-000000-000000"

# The team's emails for the budget alerts, besides the billing account's admins and users. At most 5.
alert_emails = ["teammate@example.com"]

# A fresh project: bootstrap.sh passes its id. Empty means deploy.toml's [gcp] project, where phase 2's registry,
# CI account and Workload Identity are taken over (imports.tf).
# project_id = ""
